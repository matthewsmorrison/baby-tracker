# ── Supabase (Project Settings → API Keys) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=            # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=# sb_publishable_... (safe for the browser)
SUPABASE_SECRET_KEY=                 # sb_secret_... — SERVER ONLY (service role)

# ── Anthropic (console.anthropic.com) — server only ─────────────────────────
ANTHROPIC_API_KEY=                   # sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5      # model used for Bea, digests, reports

# ── Web push (generate once: npx web-push generate-vapid-keys) ──────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                   # SERVER ONLY
VAPID_SUBJECT=                       # mailto:you@example.com

# ── Scheduled notifications (GitHub Action → /api/cron/notify) ──────────────
CRON_SECRET=                         # long random string; also set as a repo Action secret

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000  # used in invite links

# APNs (native iOS push) — create an APNs auth key at developer.apple.com →
# Certificates, Identifiers & Profiles → Keys. Optional: iOS push is skipped
# gracefully when unset.
APNS_TEAM_ID=            # Apple Developer team id (top right of the portal)
APNS_KEY_ID=             # the key's id
APNS_PRIVATE_KEY=        # contents of the .p8 file (\n-escaped)
APNS_TOPIC=io.morta.beanlo
APNS_ENV=production      # "sandbox" for Xcode-run debug builds
